# Furia Bot WhatsApp - Environment Configuration
# Copy this file to .env and fill in your actual values

# Server
NODE_ENV=development
PORT=3000

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-xxx

# Supabase
SUPABASE_PROJECT_ID=zrwhnkcetggrfcnpkixa
SUPABASE_URL=https://zrwhnkcetggrfcnpkixa.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/furia_bot

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_QUERIES_PER_HOUR=30
RATE_LIMIT_WINDOW_MS=3600000

# Roles
SUPPORTED_ROLES=CEO,CFO,COO,ERC

# Divisions
DIVISIONS=Bebidas,Gear,Reestructuración

# Daily Report
DAILY_REPORT_HOUR=7
DAILY_REPORT_MINUTE=0
DAILY_REPORT_TIMEZONE=America/Caracas
DAILY_REPORT_EMAIL=irrael@me.com

# Audit & Security
ENABLE_AUDIT_LOGGING=true
ENCRYPTION_KEY=your_encryption_key
